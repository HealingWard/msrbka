×2"],"sheet":["220x240","240x260"],"pillowcases":["70x70 ×2","50x70 ×2"],"bedWidth":[160,200],"duvet":"2 × 140x205"},{"key":"детский","aliases":["ясельный","детское","baby"],"duvetCover":["112x147","100x140"],"sheet":["120x150","100x150"],"pillowcases":["40x60 ×1"],"bedWidth":[60,70],"duvet":"110x140"}]},"letterRu":{"women":{"XXS":[38,40],"XS":[40,42],"S":[42,44],"M":[44,46],"L":[46,48],"XL":[48,50],"XXL":[50,52],"3XL":[52,54],"4XL":[54,56],"5XL":[56,58],"6XL":[58,60]},"men":{"XS":[44,46],"S":[46,48],"M":[48,50],"L":[50,52],"XL":[52,54],"XXL":[54,56],"3XL":[56,58],"4XL":[58,60],"5XL":[60,62],"6XL":[62,64],"XXS":[42,44]}},"inseam":{"28":71,"30":76,"32":81,"34":86,"36":91,"38":97},"rules":{"clothesWomen":"RU = DE/EU + 6 = FR + 4 = IT + 2 = UK + 34 = US + 38; RU ≈ обхват груди / 2. Буква INT в российских таблицах (Lamoda, Stockmann) на одну ступень «меньше», чем у европейских брендов (Zara, H&M, Mango: EU 38 = M = RU 44, у Lamoda M = RU 46). Поэтому буква соответствует двум RU-размерам: M = 44–46 (как LETTER_RU в src/lib/search.js).","clothesMen":"RU = EU/DE = IT = FR; UK = US = обхват груди в дюймах = RU − 10. Буква: Lamoda M = 48, H&M/Zara M = 48–50 → буква = [n, n+2].","jeans":"W = талия в дюймах; RU ≈ W + 16 (W28 = 44, W32 = 48) и для женщин, и для мужчин; нечётный W — между двумя RU (W27 = 42/44). L = длина по внутреннему шву, дюймы.","shoes":"Основное правило: RU = EU − 1 (EU 38 = RU 37 при стопе ~24 см); в магазинах Lamoda/Stockmann у европейских брендов (Geox, Mango, Massimo Dutti, Zara) так и указано. Исключения: (1) спортивные бренды (Nike, Adidas, New Balance) дают дробные EU (38 2/3, 42 1/2) — их переводим через длину стопы в см к ближайшему RU; (2) часть российских и турецких брендов и маркетплейсов пишут RU = EU (без сдвига) — такое не угадать по числу, поэтому голое число на карточке считаем RU магазина (Stockmann main, Lamoda size), а размер с пометкой EU — сдвигаем на 1; (3) UK/US различаются по брендам на 0,5: Nike women US = UK + 2,5, Adidas women US = UK + 1,5; в таблице — среднее правило US(ж) = UK + 2, US(м) = UK + 1.","kids":"Размер детской одежды = рост в см (EU). Возраст «N лет» (Zara, «4 года 104 см») = верхняя граница диапазона H&M «3–4Y» = 104. US 2T–5T = 92–110. RU по обхвату груди (ruChest) только для справки.","kidsShoes":"EU = RU для детской обуви в большинстве магазинов; длина стопы ≈ EU/1,5 − 1 см.","bra":"RU = EU = обхват под грудью (см) + чашка; UK/US: 75 → 34 (шаг 5 см = 2 дюйма); FR = EU + 15; IT: 70 = 2, 75 = 3 (Intimissimi). Чашки до D совпадают, дальше: EU E = UK DD = US DD/E; EU F = UK E = US DDD/F.","rings":"RU = внутренний диаметр, мм (шаг 0,5); ISO 8653/EU = внутренняя окружность, мм = π·d; US = (d − 11,63)/0,8255 (US 7 ≈ 17,3–17,5).","belts":"Размер ремня в см — длина до среднего отверстия, ≈ талия по брюкам + 10–15 см; S/M/L у итальянских брендов (Coccinelle, Furla) обычно 75/85/95 — см. таблицу бренда.","gloves":"Размер = обхват ладони в дюймах; буквы для женщин и мужчин различаются (женская M = 7,5, мужская M = 9).","hats":"RU = обхват головы в см; US fitted = обхват/π в дюймах (56 см = 7).","bedding":"Ключи как bedKey() в src/lib/search.js: 1-спальный, 1,5-спальный, 2-спальный, евро, евромакси (king), семейный (дуэт: 2 пододеяльника). Наволочки 70×70 — российский стандарт, 50×70 — европейский."},"parsing":{"notes":["Сначала: lower-case, ё→е, убрать «размер», «р.», «р-р», «-й», «size»; десятичная запятая → точка («39,5» → 39.5); ½ ⅓ ⅔ и «38 2/3» → дробь.","Метка разбивается по «/», «,», «(» «)» и « или » на части; каждая часть — свой токен в своей системе («M/46» = INT M + RU 46). Исключение: в системе jeans «28/32» = W28 L32; в постельном белье «1,5-сп» — не разбиваем.","Префикс или суффикс системы: RU|RUS|РОС, EU|EUR|ЕВР, IT, FR, DE, UK, US (US W/M), INT, JP, CM/СМ. Без пометки число считается RU-размером магазина (Stockmann main, Lamoda size — это RU).","Диапазон «40-41», «XS-S», «42-44», «104-110»: все размеры между концами (у обуви включая половинки, у одежды шаг 2, у роста — шаг сетки 6 см).","Если с обеих сторон есть буква INT — сравниваем буквы (как sizeEq). Если у вещи есть RU-число — сравниваем по нему, а не по букве (запрос «44» ≠ «M/46»). Буква против числа — через диапазон буквы (M = 44–46).","OneSize / без размера / единый — подходит к любому запросу.","Голые числа по системам: одежда 38–64 → RU; обувь 15–50 → RU (детская = EU); кольца 3–13 → US, 14–24 → диаметр RU, 40–75 → окружность ISO; бюстгальтер «75B» → EU/RU, «34B» (28–46) → UK/US, «90B» с FR → FR, «3B» (1–9) → IT; дети 44–188 → рост; шапки 50–64 → см; ремни 60–140 → см; перчатки 5–12 → дюймы.","Размер белья распознаётся по ключевым словам раньше чисел: «1,5-сп» содержит 1,5, но это не размер 1,5."],"regex":{"cleanup":"(?:^|\\s)(?:размер[а-я]*|р-р|р\\.|size)(?=\\s|$|\\d)|-?й\\b","system":"\\b(ru|rus|рос|eu|eur|евр|it|fr|de|uk|us|int|jp|cm|см)\\b","letter":"^(?:xxxs|xxs|xs|s|m|l|xl|xxl|xxxl|[2-6]xl|[2-4]xs)$","letterRange":"^((?:[2-6]?x{0,3}[sml]))\\s*[-–—]\\s*((?:[2-6]?x{0,3}[sml]))$","number":"^(\\d{1,3}(?:[.,]\\d{1,2})?)(?:\\s*(1\\/2|1\\/3|2\\/3|½|⅓|⅔))?$","numberRange":"^(\\d{1,3}(?:[.,]\\d)?)\\s*[-–—]\\s*(\\d{1,3}(?:[.,]\\d)?)$","jeans":"^w\\s*(\\d{2})(?:\\s*[/ ]?\\s*l\\s*(\\d{2}))?$|^(\\d{2})\\s*[/x]\\s*(\\d{2})$","bra":"^(\\d{2,3})\\s*-?\\s*(aa|a|b|c|dd|ddd|d|e|ff|f|g|h)$|^(aa|a|b|c|dd|ddd|d|e|ff|f|g|h)\\s*(\\d{2,3})$","bed":"(евро\\s*-?\\s*макси|евромакси|king|евро|euro|queen|семейн[а-я]*|дуэт|двуспальн[а-я]*|двухспальн[а-я]*|односпальн[а-я]*|полуторн[а-я]*(?:\\s*-?\\s*спальн[а-я]*)?|(?:1[,.]5|2|1|двух)\\s*-?\\s*(?:х\\s*)?(?:спальн[а-я]*|сп\\.?))","universal":"^(без размера|one ?size|onesize|ns|uni|единый|универсальн)","kidsAge":"^(\\d{1,2})\\s*(?:[-–]\\s*(\\d{1,2}))?\\s*(лет|год[а]?|y|yrs?|years?|a|ans|t|м|мес|m|months?)$"},"examples":{"M/46":[{"sys":"int","v":"M"},{"sys":"ru","v":46}],"EU 39":[{"sys":"eu","v":39}],"39,5":[{"sys":"ru","v":39.5}],"40-41":[{"sys":"ru","v":40},{"sys":"ru","v":40.5},{"sys":"ru","v":41}],"XS-S":[{"sys":"int","v":"XS"},{"sys":"int","v":"S"}],"W28 L32":[{"sys":"w","v":28,"l":32}],"75B":[{"sys":"eu","band":75,"cup":"B"}],"17,5":[{"sys":"ru","v":17.5,"note":"кольцо: диаметр 17,5 мм"}],"евро":[{"sys":"bed","v":"евро"}],"1,5-сп":[{"sys":"bed","v":"1,5-спальный"}]}},"note":"Таблицы размеров (RU/INT/EU/IT/UK/US, обувь, джинсы, бельё, кольца, постельное бельё). Собрано в 2026-10, см. docs/knowledge-base.md."}