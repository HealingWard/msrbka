{
  "manifest_version": 3,
  "name": "Прицел — поиск в магазинах",
  "short_name": "Прицел",
  "version": "0.3.1",
  "description": "Ищет товары в Stockmann и Lamoda для сайта «Прицел»: открывает выдачу и карточки товаров в вашем браузере и собирает цены, размеры, цвет и бренд.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "https://stockmann.ru/*",
    "https://*.stockmann.ru/*",
    "https://www.lamoda.ru/*",
    "https://lamoda.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://healingward.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Прицел",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon.png"
  }
}
